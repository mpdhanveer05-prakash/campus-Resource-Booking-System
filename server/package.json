{
  "name": "campus-resource-booking-server",
  "version": "1.0.0",
  "description": "Campus Resource Booking System API",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "nodemon --exec \"node --env-file-if-exists=.env\" src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "lint": "eslint .",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js up",
    "db:migrate:down": "node --env-file-if-exists=.env scripts/migrate.js down",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "db:reset": "node --env-file-if-exists=.env scripts/reset.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "argon2": "0.45.1",
    "connect-pg-simple": "10.0.0",
    "dotenv": "18.0.1",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "node-pg-migrate": "9.0.0",
    "nodemon": "3.1.14",
    "pino-pretty": "13.1.3",
    "supertest": "7.2.2",
    "vitest": "5.0.1"
  }
}
