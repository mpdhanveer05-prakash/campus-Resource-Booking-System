# Campus Resource Booking System - server environment
# Copy to .env and fill in real values. Never commit .env.

# Port the API listens on locally.
PORT=4000

# development | test | production
NODE_ENV=development

# Runtime database connection. Server-only secret.
# Use a non-superuser application account.
DATABASE_URL=postgresql://app_user:replace_me@localhost:5432/campus_booking_dev

# Exact browser origin allowed to make requests (the Vite dev server locally).
APP_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
