# Campus Resource Booking System - server environment
# Copy to .env and fill in real values. Never commit .env.

# Port the API listens on locally.
PORT=4000

# development | test | production
NODE_ENV=development

# Runtime database connection. Server-only secret.
# Uses the least-privilege campus_app role; the local container publishes 5433
# so it does not collide with a native PostgreSQL install on 5432.
DATABASE_URL=postgresql://campus_app:change_me_locally@localhost:5433/campus_booking_dev

# Migration account connection. Available to migration jobs only.
MIGRATION_DATABASE_URL=postgresql://campus_migrator:change_me_locally@localhost:5433/campus_booking_dev

# Isolated integration-test database. Never point this at the dev database.
TEST_DATABASE_URL=postgresql://campus_migrator:change_me_locally@localhost:5433/campus_booking_test

# Long random value. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace_with_a_long_random_value

# Exact browser origin allowed to make requests (the Vite dev server locally).
APP_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Initial administrator created by the seed command. Not a public default.
SEED_ADMIN_EMAIL=admin@campus.local
SEED_ADMIN_PASSWORD=replace_with_a_private_password
