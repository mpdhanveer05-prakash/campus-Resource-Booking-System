# Compose development database configuration.
# Copy to infra/.env and set real local passwords. Never commit infra/.env.
#
# Compose automatically loads the .env file sitting beside the compose file's
# project directory; these values are consumed by infra/compose.dev.yml and by
# infra/db-init/01-roles-and-databases.sh on first initialisation.

# Superuser for the local container only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=campus_booking_dev

# Isolated integration-test database, created on first init.
TEST_DB_NAME=campus_booking_test

# Schema owner used by migrations.
APP_MIGRATION_PASSWORD=change_me_locally

# Least-privilege runtime account used by the API.
APP_RUNTIME_PASSWORD=change_me_locally
